# citizenID — example environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored and must never be committed.

# ─── Application secrets ──────────────────────────────────────────────
# Secret used to sign/verify session & refresh tokens (HMAC key).
# REQUIRED in any real deployment. Generate a long random value, e.g.:
#     openssl rand -base64 48
# NOTE: the code falls back to an insecure built-in default if this is
# unset — never rely on that default outside local development.
SECRET_KEY=

# Salt key used in password/token hashing. REQUIRED in production.
# Generate a random value, e.g. `openssl rand -base64 16`.
SALT_KEY=

# UUID of the first-party ("master") OAuth client that owns the user API.
# Must match a client provisioned in your applications table.
MASTER_CLIENT_ID=

# ─── CORS ─────────────────────────────────────────────────────────────
# Space-separated list of allowed origins (exact, scheme included).
# Leave empty to allow none. Example:
#     CORS_ORIGINS="https://citizen-id.space https://staging.citizen-id.space"
CORS_ORIGINS=

# Whether to send `Access-Control-Allow-Credentials: true`. "true" or "false".
CORS_ALLOW_CREDENTIALS=false

# ─── AWS / DynamoDB ───────────────────────────────────────────────────
# The service uses the standard AWS SDK credential chain. The default
# build (feature `dynamodb`) loads the "dev" profile; the `tempdb`
# feature loads the "local" profile. You can configure either via
# ~/.aws/{config,credentials} profiles or the env vars below.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For local development against DynamoDB Local (see tools/dynamodb-local.yml,
# which listens on :8000), point the SDK at the local endpoint and use any
# dummy credentials:
#     AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
#     AWS_ACCESS_KEY_ID=DUMMYIDEXAMPLE
#     AWS_SECRET_ACCESS_KEY=DUMMYEXAMPLEKEY
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────
# tracing/env_logger filter. Defaults to "info" if unset.
RUST_LOG=info
